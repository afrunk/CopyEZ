# 忽略 Python 运行缓存
__pycache__/
*.pyc

# 忽略虚拟环境
venv/
.venv/
node_modules/
package-lock.json

# 忽略用户上传的文件（所有 uploads 和 avatars 目录）
static/uploads/*
static/wechat/uploads/*
static/wechat/avatars/*
static/decoration/uploads/*
static/diary/uploads/*

# 忽略配置文件（包含数据库密码或密钥）
.env
instance/
*.db

# 忽略日志文件（运行时产生）
logs/

# 忽略系统文件
.DS_Store
Thumbs.db

# 忽略临时文件
diary_server.log
master.txt
pup.txt
nul
test-results/